RETRY qcd_PT_120_170 3

JOB   qcd_PT_170_300 /home/hep/jtafoyav/vols/parking/nanoaod_base_analysis_13/dqcd/_tools/condor/compareDeltaR_shard.sub
VARS  qcd_PT_170_300 SHARD="QCD_Bin-PT-170to300_Fil-MuEnriched_TuneCP5_13p6TeV_pythia8"
RETRY qcd_PT_170_300 3

JOB   qcd_PT_300_470 /home/hep/jtafoyav/vols/parking/nanoaod_base_analysis_13/dqcd/_tools/condor/compareDeltaR_shard.sub
VARS  qcd_PT_300_470 SHARD="QCD_Bin-PT-300to470_Fil-MuEnriched_TuneCP5_13p6TeV_pythia8"
RETRY qcd_PT_300_470 3

JOB   qcd_PT_470_600 /home/hep/jtafoyav/vols/parking/nanoaod_base_analysis_13/dqcd/_tools/condor/compareDeltaR_shard.sub
VARS  qcd_PT_470_600 SHARD="QCD_Bin-PT-470to600_Fil-MuEnriched_TuneCP5_13p6TeV_pythia8"
