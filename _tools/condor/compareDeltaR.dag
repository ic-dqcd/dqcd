JOB   signal /home/hep/jtafoyav/vols/parking/nanoaod_base_analysis_13/dqcd/_tools/condor/compareDeltaR_shard.sub
VARS  signal SHARD="signal"
RETRY signal 3

# MinBias: ~100 files (5% of 1993), so the shortest job in the DAG by a wide margin.
# It is a PARENT of merge like everything else even though load_shards() only WARNS on a
# missing MinBias shard -- the warning exists so old shard directories stay mergeable,
# not so this DAG may quietly drop a curve.
JOB   minbias /home/hep/jtafoyav/vols/parking/nanoaod_base_analysis_13/dqcd/_tools/condor/compareDeltaR_shard.sub
VARS  minbias SHARD="minbias"
RETRY minbias 3

JOB   merge /home/hep/jtafoyav/vols/parking/nanoaod_base_analysis_13/dqcd/_tools/condor/compareDeltaR_merge.sub

# merge runs only once every shard has succeeded
PARENT qcd_PT_15_20 qcd_PT_20_30 qcd_PT_30_50 qcd_PT_50_80 qcd_PT_80_120 qcd_PT_120_170 qcd_PT_170_300 qcd_PT_300_470 qcd_PT_470_600 qcd_PT_600_800 qcd_PT_800_1000 qcd_PT_1000 signal minbias CHILD merge
