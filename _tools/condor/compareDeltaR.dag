# compareDeltaR over the FULL sample, sharded one job per QCD PT-hat bin.
# Generated from compareDeltaR.QCD_XS -- regenerate rather than hand-edit if the
# bin list ever changes, so the DAG and the merge guard cannot drift apart.
#   condor_submit_dag _tools/condor/compareDeltaR.dag

JOB   qcd_PT_15_20 /home/hep/jtafoyav/vols/parking/nanoaod_base_analysis_13/dqcd/_tools/condor/compareDeltaR_shard.sub
VARS  qcd_PT_15_20 SHARD="QCD_Bin-PT-15to20_Fil-MuEnriched_TuneCP5_13p6TeV_pythia8"
RETRY qcd_PT_15_20 3

JOB   qcd_PT_20_30 /home/hep/jtafoyav/vols/parking/nanoaod_base_analysis_13/dqcd/_tools/condor/compareDeltaR_shard.sub
VARS  qcd_PT_20_30 SHARD="QCD_Bin-PT-20to30_Fil-MuEnriched_TuneCP5_13p6TeV_pythia8"
RETRY qcd_PT_20_30 3

JOB   qcd_PT_30_50 /home/hep/jtafoyav/vols/parking/nanoaod_base_analysis_13/dqcd/_tools/condor/compareDeltaR_shard.sub
VARS  qcd_PT_30_50 SHARD="QCD_Bin-PT-30to50_Fil-MuEnriched_TuneCP5_13p6TeV_pythia8"
RETRY qcd_PT_30_50 3

JOB   qcd_PT_50_80 /home/hep/jtafoyav/vols/parking/nanoaod_base_analysis_13/dqcd/_tools/condor/compareDeltaR_shard.sub
VARS  qcd_PT_50_80 SHARD="QCD_Bin-PT-50to80_Fil-MuEnriched_TuneCP5_13p6TeV_pythia8"
RETRY qcd_PT_50_80 3

JOB   qcd_PT_80_120 /home/hep/jtafoyav/vols/parking/nanoaod_base_analysis_13/dqcd/_tools/condor/compareDeltaR_shard.sub
